# ease-Desk Openbox Theme
# A modern, dark, flat theme designed for ease-Desk with 4px borders for easy resizing.

border.width: 4
window.handle.width: 4
window.client.padding.width: 0

# Fonts
window.active.label.text.font: Inter:weight=Bold:size=10
window.inactive.label.text.font: Inter:weight=Bold:size=10

# Active Window
window.active.border.color: #89b4fa
window.active.title.bg: flat solid
window.active.title.bg.color: #181825
window.active.label.bg: parentrelative
window.active.label.text.color: #cdd6f4
window.active.handle.bg: flat solid
window.active.handle.bg.color: #181825
window.active.grip.bg: parentrelative

# Inactive Window
window.inactive.border.color: #313244
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #11111b
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #a6adc8
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #11111b
window.inactive.grip.bg: parentrelative

# Window Buttons
window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #a6adc8
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #313244
window.active.button.pressed.image.color: #cdd6f4
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #45475a
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #45475a
window.active.button.hover.image.color: #ffffff

window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #a6adc8
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #313244
window.active.button.toggled.pressed.image.color: #cdd6f4
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #45475a
window.active.button.toggled.hover.image.color: #ffffff

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #585b70
window.inactive.button.pressed.bg: parentrelative
window.inactive.button.pressed.image.color: #cdd6f4
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #313244
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #313244
window.inactive.button.hover.image.color: #cdd6f4

window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #585b70
window.inactive.button.toggled.pressed.bg: parentrelative
window.inactive.button.toggled.pressed.image.color: #cdd6f4
window.inactive.button.toggled.hover.bg: flat solid
window.inactive.button.toggled.hover.bg.color: #313244
window.inactive.button.toggled.hover.image.color: #cdd6f4

# Menus
menu.border.width: 1
menu.border.color: #313244
menu.title.bg: flat solid
menu.title.bg.color: #181825
menu.title.text.color: #cdd6f4
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #11111b
menu.items.text.color: #cdd6f4
menu.items.disabled.text.color: #585b70
menu.items.active.bg: flat solid
menu.items.active.bg.color: #89b4fa
menu.items.active.text.color: #11111b

# OSD
osd.border.width: 1
osd.border.color: #89b4fa
osd.bg: flat solid
osd.bg.color: #11111b
osd.label.bg: flat solid
osd.label.bg.color: #11111b
osd.label.text.color: #cdd6f4
osd.hilight.bg: flat solid
osd.hilight.bg.color: #89b4fa
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #313244
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #181825
osd.button.unpressed.border.color: #313244
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #313244
osd.button.pressed.border.color: #45475a
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #313244
osd.button.focused.border.color: #89b4fa
osd.button.focused.box.color: #89b4fa
