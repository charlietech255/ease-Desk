#!/usr/bin/env bash
# ==============================================================================
# ease-Desk CLI Launcher
# ==============================================================================
set -e

# Resolve symlinks to find the real script and project root directory
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT_DIR="$(cd -P "${SCRIPT_DIR}/.." && pwd)"

# Ensure ease-Desk root is on the Python path
export PYTHONPATH="${ROOT_DIR}:${PYTHONPATH}"

# Unset any stale DISPLAY env var so session.py can detect the environment fresh.
# On a headless VPS, DISPLAY=:0 may be set in /etc/environment but no real
# X server is running — trusting it causes "Gtk couldn't be initialized".
# Session manager will start Xvfb + noVNC automatically if no real display found.
unset DISPLAY

# Launch session manager
exec python3 -m desktop.session.session "$@"
